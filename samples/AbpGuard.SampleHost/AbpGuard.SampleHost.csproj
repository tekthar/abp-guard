<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>A host of Guard alone: Guard's own modules and defaults, nothing of any product's. What another product does to use Guard, and what AbpGuard.Host.Tests proves.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AbpGuard.HttpApi\AbpGuard.HttpApi.csproj" />
    <PackageReference Include="Volo.Abp.Autofac" Version="$(AbpVersion)" />
    <!-- Guard's API as its own document (/openapi/abpguard.json), which docs/openapi/abpguard.json keeps and screens' types come from. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

</Project>
